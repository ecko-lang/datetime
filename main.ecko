# datetime - calendar dates, times, and durations for Ecko.
#
# A datetime is a Unix-millisecond Int (UTC) - the same thing `std.time.now()`
# returns - so two datetimes compare and subtract with plain `<` and `-`. This
# package adds the calendar math that std.time lacks: components, durations,
# and arithmetic. All pure; no capabilities.
#
#   import datetime as dt
#
#   now = dt.now()
#   c = dt.components(now)         # { year, month, day, hour, minute, ... }
#   soon = dt.add_days(now, 3)
#   dt.format(now, "%Y-%m-%d")
#
# Calendar conversion uses Howard Hinnant's days<->civil algorithm in its
# floor-division form (Ecko's `//`), so it is correct for every
# proleptic-Gregorian date, before and after 1970.

import std.str
import std.time

# ---- constants -------------------------------------------------------------
MS_DAY = 86400000
MS_HOUR = 3600000
MS_MIN = 60000
MS_SEC = 1000

# `//` and `%` both floor, so the ms<->day split below is right for instants
# before 1970 as well: -1 ms is 1969-12-31 23:59:59.999, not a day off.

# ---- errors ---------------------------------------------------------------
# A programmer mistake (wrong type): kind `bug`, raised at the exported
# function's boundary with the function and argument named.
fn want_int(fname, arg, v) {
    if type_of(v) != "int" {
        error(
            {
                kind: "bug",
                reason: "bad_argument",
                message: "datetime.{fname}: `{arg}` must be an Int, got {type_of(v)} {v}",
            },
        )
    }
    v
}

fn want_string(fname, arg, v) {
    if type_of(v) != "string" {
        error(
            {
                kind: "bug",
                reason: "bad_argument",
                message: "datetime.{fname}: `{arg}` must be a String, got {type_of(v)} {v}",
            },
        )
    }
    v
}

# An impossible calendar value: kind `datetime`, the data's fault.
fn invalid_date(fname, what, v, range) {
    error(
        {
            kind: "datetime",
            reason: "invalid_date",
            message: "datetime.{fname}: {what} {v} is out of range ({range})",
            field: what,
            value: v,
        },
    )
}

# ---- the calendar core (Hinnant) -------------------------------------------
# civil_from_days(z) -> [year, month, day]; z = days since 1970-01-01.
fn civil_from_days(z0) {
    z = z0 + 719468
    era = z // 146097
    doe = z - era * 146097
    yoe = (doe - doe // 1460 + doe // 36524 - doe // 146096) // 365
    y = yoe + era * 400
    doy = doe - (365 * yoe + yoe // 4 - yoe // 100)
    mp = (5 * doy + 2) // 153
    d = doy - (153 * mp + 2) // 5 + 1
    m = if mp < 10 { mp + 3 } else { mp - 9 }
    yy = if m <= 2 { y + 1 } else { y }
    [yy, m, d]
}

# days_from_civil(y, m, d) -> days since 1970-01-01.
fn days_from_civil(y0, m, d) {
    y = if m <= 2 { y0 - 1 } else { y0 }
    era = y // 400
    yoe = y - era * 400
    doy = (153 * if m > 2 { m - 3 } else { m + 9 } + 2) // 5 + d - 1
    doe = yoe * 365 + yoe // 4 - yoe // 100 + doy
    era * 146097 + doe - 719468
}

# ---- now -------------------------------------------------------------------
## The current time as Unix milliseconds (UTC), the same value as `std.time.now()`.
export fn now() = time.now()

# ---- components ------------------------------------------------------------
## The calendar fields of a timestamp, in UTC:
## `{ year, month, day, hour, minute, second, millisecond, weekday, yearday }`.
##
## `month` is 1-12, `weekday` is 0 (Monday) to 6 (Sunday) and `yearday` is
## 1-366. Works for every proleptic-Gregorian year, before 1970 included.
##
## errors: `bug`/`bad_argument` when `ms` is not an Int.
##
## example:
##   components(0).weekday   # 3, a Thursday
export fn components(ms) {
    want_int("components", "ms", ms)
    dnum = ms // MS_DAY
    tod = ms - dnum * MS_DAY  # 0 .. 86399999
    ymd = civil_from_days(dnum)
    yr = ymd[0]
    {
        year: yr,
        month: ymd[1],
        day: ymd[2],
        hour: tod // MS_HOUR,
        minute: tod // MS_MIN % 60,
        second: tod // MS_SEC % 60,
        millisecond: tod % MS_SEC,
        weekday: (dnum + 3) % 7,
        yearday: dnum - days_from_civil(yr, 1, 1) + 1,
    }
}

## The UTC timestamp, in milliseconds, of a calendar date and time of day.
##
## The time of day defaults to midnight. Every field is checked: an impossible
## date such as 30 February is refused rather than rolled into March.
##
## errors: `datetime`/`invalid_date` when a field is outside its range (month
## 1-12, day 1 to the month's length, hour 0-23, minute and second 0-59,
## millisecond 0-999); `bug`/`bad_argument` when a field is not an Int.
##
## example:
##   from_components(1970, 1, 2)   # 86400000
export fn from_components(y, mo, d, h = 0, mi = 0, s = 0, milli = 0) {
    f = "from_components"
    want_int(f, "y", y)
    want_int(f, "mo", mo)
    want_int(f, "d", d)
    want_int(f, "h", h)
    want_int(f, "mi", mi)
    want_int(f, "s", s)
    want_int(f, "milli", milli)
    if mo < 1 or mo > 12 { invalid_date(f, "month", mo, "1-12") }
    dim = month_length(y, mo)
    if d < 1 or d > dim { invalid_date(f, "day", d, "1-{dim} in {y}-{mo}") }
    if h < 0 or h > 23 { invalid_date(f, "hour", h, "0-23") }
    if mi < 0 or mi > 59 { invalid_date(f, "minute", mi, "0-59") }
    if s < 0 or s > 59 { invalid_date(f, "second", s, "0-59") }
    if milli < 0 or milli > 999 { invalid_date(f, "millisecond", milli, "0-999") }
    days_from_civil(y, mo, d) * MS_DAY + h * MS_HOUR + mi * MS_MIN + s * MS_SEC + milli
}

# ---- convenience extractors ------------------------------------------------
## The calendar year (UTC).
##
## errors: `bug`/`bad_argument` when `ms` is not an Int.
export fn year(ms) = components(ms).year
## The calendar month, 1-12 (UTC).
##
## errors: `bug`/`bad_argument` when `ms` is not an Int.
export fn month(ms) = components(ms).month
## The day of the month, 1-31 (UTC).
##
## errors: `bug`/`bad_argument` when `ms` is not an Int.
export fn day(ms) = components(ms).day
## The hour of the day, 0-23 (UTC).
##
## errors: `bug`/`bad_argument` when `ms` is not an Int.
export fn hour(ms) = components(ms).hour
## The minute of the hour, 0-59.
##
## errors: `bug`/`bad_argument` when `ms` is not an Int.
export fn minute(ms) = components(ms).minute
## The second of the minute, 0-59.
##
## errors: `bug`/`bad_argument` when `ms` is not an Int.
export fn second(ms) = components(ms).second
## The day of the week, 0 (Monday) to 6 (Sunday), the ISO ordering.
##
## errors: `bug`/`bad_argument` when `ms` is not an Int.
export fn weekday(ms) = components(ms).weekday

WEEKDAYS = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]
MONTHS = [
    "January",
    "February",
    "March",
    "April",
    "May",
    "June",
    "July",
    "August",
    "September",
    "October",
    "November",
    "December",
]

## The weekday in English, "Monday" through "Sunday".
##
## errors: `bug`/`bad_argument` when `ms` is not an Int.
##
## example:
##   weekday_name(0)   # "Thursday"
export fn weekday_name(ms) = WEEKDAYS[weekday(ms)]
## The month in English, "January" through "December".
##
## errors: `bug`/`bad_argument` when `ms` is not an Int.
##
## example:
##   month_name(0)   # "January"
export fn month_name(ms) = MONTHS[month(ms) - 1]

# ---- calendar predicates ---------------------------------------------------
## Whether `y` is a leap year, by the full Gregorian rule.
##
## errors: `bug`/`bad_argument` when `y` is not an Int.
##
## example:
##   is_leap(1900)   # false
export fn is_leap(y) {
    want_int("is_leap", "y", y)
    leap(y)
}

fn leap(y) = y % 4 == 0 and y % 100 != 0 or y % 400 == 0

# Days in month `m` (already known to be 1-12) of year `y`.
fn month_length(y, m) {
    if m == 2 {
        if leap(y) { 29 } else { 28 }
    } else if m == 4 or m == 6 or m == 9 or m == 11 {
        30
    } else {
        31
    }
}

## How many days month `m` (1-12) has in year `y`, accounting for leap years.
##
## errors: `datetime`/`invalid_date` when `m` is outside 1-12;
## `bug`/`bad_argument` when `y` or `m` is not an Int.
##
## example:
##   days_in_month(2024, 2)   # 29
export fn days_in_month(y, m) {
    want_int("days_in_month", "y", y)
    want_int("days_in_month", "m", m)
    if m < 1 or m > 12 { invalid_date("days_in_month", "month", m, "1-12") }
    month_length(y, m)
}

# ---- durations (plain milliseconds) ----------------------------------------
## `n` milliseconds as a duration, for `add` and `sub`. The identity, so a
## duration is always spelled the same way.
##
## errors: `bug`/`bad_argument` when `n` is not an Int.
export fn millis(n) = want_int("millis", "n", n)
## `n` seconds as a duration in milliseconds.
##
## errors: `bug`/`bad_argument` when `n` is not an Int.
##
## example:
##   seconds(2)   # 2000
export fn seconds(n) = want_int("seconds", "n", n) * MS_SEC
## `n` minutes as a duration in milliseconds.
##
## errors: `bug`/`bad_argument` when `n` is not an Int.
export fn minutes(n) = want_int("minutes", "n", n) * MS_MIN
## `n` hours as a duration in milliseconds.
##
## errors: `bug`/`bad_argument` when `n` is not an Int.
export fn hours(n) = want_int("hours", "n", n) * MS_HOUR
## `n` days as a duration in milliseconds, exactly 24 hours each.
##
## errors: `bug`/`bad_argument` when `n` is not an Int.
export fn days(n) = want_int("days", "n", n) * MS_DAY
## `n` weeks as a duration in milliseconds.
##
## errors: `bug`/`bad_argument` when `n` is not an Int.
export fn weeks(n) = want_int("weeks", "n", n) * 7 * MS_DAY

# ---- arithmetic ------------------------------------------------------------
## The timestamp `duration` milliseconds later.
##
## errors: `bug`/`bad_argument` when either argument is not an Int.
##
## example:
##   add(0, hours(3))   # 10800000
export fn add(ms, duration) = want_int("add", "ms", ms) + want_int("add", "duration", duration)
## The timestamp `duration` milliseconds earlier.
##
## errors: `bug`/`bad_argument` when either argument is not an Int.
##
## example:
##   sub(now(), days(7))   # a week ago
export fn sub(ms, duration) = want_int("sub", "ms", ms) - want_int("sub", "duration", duration)
## The milliseconds between two timestamps, `a - b`; negative when `a` is earlier.
##
## errors: `bug`/`bad_argument` when either argument is not an Int.
export fn diff(a, b) = want_int("diff", "a", a) - want_int("diff", "b", b)
## The whole days between two timestamps, `a - b`, rounded toward negative infinity.
##
## errors: `bug`/`bad_argument` when either argument is not an Int.
##
## example:
##   diff_days(0, 1)   # -1
export fn diff_days(a, b) = (want_int("diff_days", "a", a) - want_int("diff_days", "b", b)) //
    MS_DAY

## The timestamp `n` days later; `n` may be negative.
##
## errors: `bug`/`bad_argument` when either argument is not an Int.
export fn add_days(ms, n) = want_int("add_days", "ms", ms) + want_int("add_days", "n", n) * MS_DAY

## The timestamp `n` calendar months later, keeping the time of day.
##
## The day is clamped to the target month's length: 31 January plus one month
## is 28 or 29 February.
##
## errors: `bug`/`bad_argument` when either argument is not an Int.
##
## example:
##   add_months(from_components(2024, 1, 31), 1)   # 2024-02-29
export fn add_months(ms, n) {
    want_int("add_months", "ms", ms)
    want_int("add_months", "n", n)
    c = components(ms)
    total = c.year * 12 + (c.month - 1) + n
    y = total // 12
    mo = total % 12 + 1
    dim = month_length(y, mo)
    d = if c.day < dim { c.day } else { dim }
    days_from_civil(y, mo, d) * MS_DAY + ms % MS_DAY
}

## The timestamp `n` years later, clamping the day where the target month is
## shorter: 29 February plus one year is 28 February.
##
## errors: `bug`/`bad_argument` when either argument is not an Int.
export fn add_years(ms, n) = add_months(ms, want_int("add_years", "n", n) * 12)

## Midnight UTC on the same day.
##
## errors: `bug`/`bad_argument` when `ms` is not an Int.
export fn start_of_day(ms) = want_int("start_of_day", "ms", ms) // MS_DAY * MS_DAY

# ---- formatting / parsing (delegated to std.time / chrono) -----------------
## The timestamp formatted with a strftime-style pattern, in UTC.
##
## Delegates to `std.time.format`, which covers years -262143 to 262142.
##
## errors: `datetime`/`out_of_range` when the year is outside that range
## (use `to_iso`, which has no limit); `bug`/`bad_format` when `fmt` has an
## unknown specifier; `bug`/`bad_argument` when `ms` is not an Int or `fmt`
## not a String.
##
## example:
##   format(0, "%Y-%m-%d")   # "1970-01-01"
export fn format(ms, fmt) {
    want_int("format", "ms", ms)
    want_string("format", "fmt", fmt)
    try {
        time.format(ms, fmt)
    } catch (e) {
        msg = string(get(e, "message") ?? e)
        if contains(msg, "out of range") {
            error(
                {
                    kind: "datetime",
                    reason: "out_of_range",
                    message: "datetime.format: timestamp {ms} (year {components(ms).year}) is outside the range format supports; use to_iso",
                    value: ms,
                },
            )
        }
        error(
            {
                kind: "bug",
                reason: "bad_format",
                message: "datetime.format: invalid format string {fmt}",
            },
        )
    }
}

# The last clause of a std.time error message: chrono's own reason.
fn detail(e) {
    parts = split(string(get(e, "message") ?? e), ": ")
    parts[len(parts) - 1]
}

fn pad(n, width) = str.pad_start(string(n), width, "0")

## The timestamp as ISO 8601 in UTC with milliseconds: `2026-07-29T13:45:00.000Z`.
##
## Years 0-9999 are four digits; others carry a sign (`-0001`, `+10000`), the
## ISO 8601 expanded form, so every timestamp `components` reads has one.
##
## errors: `bug`/`bad_argument` when `ms` is not an Int.
##
## example:
##   to_iso(0)   # "1970-01-01T00:00:00.000Z"
export fn to_iso(ms) {
    want_int("to_iso", "ms", ms)
    c = components(ms)
    y = c.year
    ys = if y >= 0 and y <= 9999 {
        pad(y, 4)
    } else if y < 0 {
        "-" + pad(0 - y, 4)
    } else {
        "+" + pad(y, 4)
    }
    "{ys}-{pad(c.month, 2)}-{pad(c.day, 2)}T{pad(c.hour, 2)}:{pad(c.minute, 2)}:{pad(c.second, 2)}.{pad(c.millisecond, 3)}Z"
}

## An RFC 3339 timestamp parsed to Unix milliseconds.
##
## The string needs a date, a time and an offset (`Z` or `+02:00`):
## `2026-07-16T10:00:00Z`. A date alone, or a time with no offset, is refused;
## use `parse_format` for those.
##
## errors: `datetime`/`bad_timestamp` when `iso` is not RFC 3339;
## `bug`/`bad_argument` when `iso` is not a String.
##
## example:
##   parse("1970-01-02T00:00:00Z")   # 86400000
export fn parse(iso) {
    want_string("parse", "iso", iso)
    try {
        time.parse(iso)
    } catch (e) {
        error(
            {
                kind: "datetime",
                reason: "bad_timestamp",
                message: "datetime.parse: {iso} is not an RFC 3339 timestamp (like 2026-07-16T10:00:00Z): {detail(e)}",
                input: iso,
            },
        )
    }
}

## `s` parsed with an explicit strftime-style format, read as UTC.
##
## errors: `datetime`/`bad_timestamp` when `s` does not match `fmt`;
## `bug`/`bad_argument` when either argument is not a String.
##
## example:
##   parse_format("29/07/2026 10:30", "%d/%m/%Y %H:%M")
export fn parse_format(s, fmt) {
    want_string("parse_format", "s", s)
    want_string("parse_format", "fmt", fmt)
    try { time.parse_format(s, fmt) } catch (e) {
        error(
            {
                kind: "datetime",
                reason: "bad_timestamp",
                message: "datetime.parse_format: {s} does not match the format {fmt}: {detail(e)}",
                input: s,
                format: fmt,
            },
        )
    }
}
