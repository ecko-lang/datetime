# Tests for the datetime package - offline, deterministic. Anchored to known
# dates: 1970-01-01 = ms 0 (a Thursday); 2000-01-01 was a Saturday.
import std.test
import "../main.ecko"
dt = main

test.case("epoch components (1970-01-01 is a Thursday)", fn() {
    c = dt.components(0)
    test.eq(c.year, 1970)
    test.eq(c.month, 1)
    test.eq(c.day, 1)
    test.eq(c.hour, 0)
    test.eq(c.minute, 0)
    test.eq(c.second, 0)
    test.eq(c.weekday, 3)  # Mon=0 .. Sun=6, so Thursday=3
})

test.case("from_components round-trips", fn() {
    ms = dt.from_components(2026, 7, 16, 13, 45, 30, 500)
    c = dt.components(ms)
    test.eq([c.year, c.month, c.day], [2026, 7, 16])
    test.eq([c.hour, c.minute, c.second, c.millisecond], [13, 45, 30, 500])
    test.eq(dt.from_components(1970, 1, 1), 0)
})

test.case("time-of-day defaults to midnight", fn() {
    c = dt.components(dt.from_components(2026, 7, 16))
    test.eq([c.hour, c.minute, c.second], [0, 0, 0])
})

test.case("weekday of a known date (2000-01-01 was a Saturday)", fn() {
    test.eq(dt.weekday(dt.from_components(2000, 1, 1)), 5)  # Saturday
    test.eq(dt.weekday_name(dt.from_components(2000, 1, 1)), "Saturday")
})

test.case("is_leap follows the Gregorian rule", fn() {
    test.ok(dt.is_leap(2000), "2000 divisible by 400")
    test.ok(not dt.is_leap(1900), "1900 divisible by 100 not 400")
    test.ok(dt.is_leap(2024), "2024 divisible by 4")
    test.ok(not dt.is_leap(2023), "2023 not divisible by 4")
})

test.case("days_in_month", fn() {
    test.eq(dt.days_in_month(2024, 2), 29)
    test.eq(dt.days_in_month(2023, 2), 28)
    test.eq(dt.days_in_month(2024, 4), 30)
    test.eq(dt.days_in_month(2024, 1), 31)
})

test.case("duration helpers are milliseconds", fn() {
    test.eq(dt.seconds(1), 1000)
    test.eq(dt.minutes(1), 60000)
    test.eq(dt.hours(1), 3600000)
    test.eq(dt.days(2), 172800000)
    test.eq(dt.weeks(1), 604800000)
})

test.case("add_days and diff", fn() {
    base = dt.from_components(2026, 7, 16)
    c = dt.components(dt.add_days(base, 3))
    test.eq([c.year, c.month, c.day], [2026, 7, 19])
    test.eq(dt.diff(dt.from_components(2026, 1, 3), dt.from_components(2026, 1, 1)), dt.days(2))
    test.eq(dt.diff_days(dt.from_components(2026, 3, 1), dt.from_components(2026, 2, 1)), 28)
})

test.case("add_months clamps to month length", fn() {
    c = dt.components(dt.add_months(dt.from_components(2024, 1, 31), 1))
    test.eq([c.year, c.month, c.day], [2024, 2, 29])  # Jan 31 + 1mo -> Feb 29 (leap)
    c2 = dt.components(dt.add_months(dt.from_components(2026, 12, 15), 1))
    test.eq([c2.year, c2.month, c2.day], [2027, 1, 15])  # crosses the year
})

test.case("add_years clamps Feb 29", fn() {
    c = dt.components(dt.add_years(dt.from_components(2024, 2, 29), 1))
    test.eq([c.year, c.month, c.day], [2025, 2, 28])
})

test.case("start_of_day floors to midnight", fn() {
    ms = dt.from_components(2026, 7, 16, 13, 45, 30)
    c = dt.components(dt.start_of_day(ms))
    test.eq([c.year, c.month, c.day, c.hour, c.minute, c.second], [2026, 7, 16, 0, 0, 0])
})

test.case("format and parse delegate to std.time", fn() {
    test.eq(dt.format(0, "%Y-%m-%d"), "1970-01-01")
    test.eq(dt.to_iso(0), "1970-01-01T00:00:00.000Z")
    test.eq(dt.components(dt.parse("2026-07-16T00:00:00Z")).year, 2026)
})

test.case("pre-1970 dates work (negative timestamps)", fn() {
    ms = dt.from_components(1969, 12, 31)
    c = dt.components(ms)
    test.eq([c.year, c.month, c.day], [1969, 12, 31])
    test.ok(ms < 0, "before the epoch is negative")
})

# ---- invalid input -------------------------------------------------------

# The error a call throws, or null when it returns.
fn caught(f) = try {
    f()
    null
} catch (e) { e }

fn expect_error(f, kind, reason) {
    e = caught(f)
    test.ok(e != null, "expected a {kind}/{reason} error, got a value")
    test.eq([get(e, "kind"), get(e, "reason")], [kind, reason])
    test.ok(type_of(get(e, "message")) == "string", "the error has a message")
}

test.case("from_components refuses impossible dates", fn() {
    expect_error(fn() dt.from_components(2026, 2, 30), "datetime", "invalid_date")
    expect_error(fn() dt.from_components(2026, 0, 1), "datetime", "invalid_date")
    expect_error(fn() dt.from_components(2026, 13, 1), "datetime", "invalid_date")
    expect_error(fn() dt.from_components(2026, 1, 0), "datetime", "invalid_date")
    expect_error(fn() dt.from_components(2026, 3, 1, 25), "datetime", "invalid_date")
    expect_error(fn() dt.from_components(2026, 3, 1, 0, 60), "datetime", "invalid_date")
    expect_error(fn() dt.from_components(2026, 3, 1, 0, 0, 60), "datetime", "invalid_date")
    expect_error(fn() dt.from_components(2026, 3, 1, 0, 0, 0, 1000), "datetime", "invalid_date")
    expect_error(fn() dt.from_components(2026, 3, 1, -1), "datetime", "invalid_date")
    expect_error(fn() dt.from_components(2025, 2, 29), "datetime", "invalid_date")
    test.eq(dt.components(dt.from_components(2024, 2, 29)).day, 29)
    test.eq(dt.components(dt.from_components(2026, 12, 31, 23, 59, 59, 999)).millisecond, 999)
})

test.case("from_components refuses non-Int fields", fn() {
    expect_error(fn() dt.from_components(2026.0, 1, 1), "bug", "bad_argument")
    expect_error(fn() dt.from_components(2026, "1", 1), "bug", "bad_argument")
    expect_error(fn() dt.from_components(2026, 1, 1, 1.5), "bug", "bad_argument")
})

test.case("days_in_month refuses a month outside 1-12", fn() {
    expect_error(fn() dt.days_in_month(2026, 13), "datetime", "invalid_date")
    expect_error(fn() dt.days_in_month(2026, 0), "datetime", "invalid_date")
    expect_error(fn() dt.days_in_month(2026, 1.0), "bug", "bad_argument")
})

test.case("timestamps and counts must be Ints", fn() {
    expect_error(fn() dt.components(1.5), "bug", "bad_argument")
    expect_error(fn() dt.year("2026"), "bug", "bad_argument")
    expect_error(fn() dt.seconds(1.5), "bug", "bad_argument")
    expect_error(fn() dt.add_days(0, 0.5), "bug", "bad_argument")
    expect_error(fn() dt.add_months(0, null), "bug", "bad_argument")
    expect_error(fn() dt.is_leap(2024.0), "bug", "bad_argument")
    expect_error(fn() dt.to_iso(null), "bug", "bad_argument")
    expect_error(fn() dt.format(0, 5), "bug", "bad_argument")
    expect_error(fn() dt.parse(5), "bug", "bad_argument")
})

test.case("to_iso covers every year components covers", fn() {
    ms = dt.from_components(300000, 1, 1)
    test.eq(dt.components(ms).year, 300000)
    test.eq(dt.to_iso(ms), "+300000-01-01T00:00:00.000Z")
    test.eq(dt.to_iso(dt.from_components(-1, 1, 1)), "-0001-01-01T00:00:00.000Z")
    test.eq(dt.to_iso(dt.from_components(10000, 3, 4, 5, 6, 7, 8)), "+10000-03-04T05:06:07.008Z")
    test.eq(dt.to_iso(dt.from_components(1, 2, 3)), "0001-02-03T00:00:00.000Z")
})

test.case("format out of chrono's range is a datetime error", fn() {
    expect_error(fn() dt.format(dt.from_components(300000, 1, 1), "%Y"), "datetime", "out_of_range")
    expect_error(fn() dt.format(0, "%Q"), "bug", "bad_format")
})

test.case("parse refuses what is not RFC 3339", fn() {
    expect_error(fn() dt.parse("2026-07-16"), "datetime", "bad_timestamp")
    expect_error(fn() dt.parse("2026-07-16T10:00:00"), "datetime", "bad_timestamp")
    test.eq(dt.parse("2026-07-16T10:00:00+02:00"), dt.from_components(2026, 7, 16, 8))
})

test.case("parse_format", fn() {
    test.eq(
        dt.parse_format("29/07/2026 10:30", "%d/%m/%Y %H:%M"),
        dt.from_components(2026, 7, 29, 10, 30),
    )
    expect_error(fn() dt.parse_format("x", "%Y"), "datetime", "bad_timestamp")
})

test.case("extractors and names", fn() {
    ms = dt.from_components(2026, 7, 16, 13, 45, 30, 250)
    test.eq([dt.year(ms), dt.month(ms), dt.day(ms)], [2026, 7, 16])
    test.eq([dt.hour(ms), dt.minute(ms), dt.second(ms)], [13, 45, 30])
    test.eq(dt.month_name(ms), "July")
    test.eq(dt.weekday_name(ms), "Thursday")
    test.eq(dt.components(ms).yearday, 197)
})

test.case("add, sub, millis", fn() {
    test.eq(dt.millis(5), 5)
    test.eq(dt.add(1000, dt.seconds(2)), 3000)
    test.eq(dt.sub(1000, dt.millis(1)), 999)
    test.eq(dt.diff_days(0, 1), -1)
})

test.case("now is an Int timestamp after 2026", fn() {
    test.ok(type_of(dt.now()) == "int", "now is an Int")
    test.ok(dt.now() > dt.from_components(2026, 1, 1), "now is recent")
})
